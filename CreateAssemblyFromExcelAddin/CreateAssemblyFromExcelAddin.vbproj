<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableComHosting>false</EnableComHosting>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <StartupObject></StartupObject>
    <MyType>Windows</MyType>
    <PublishUrl>http://localhost/InventorAddIn/</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Web</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <Configurations>Debug;Release</Configurations>
	<ProjectName Condition=" '$(ProjectName)' == '' ">CreateAssemblyFromExcelAddin</ProjectName>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DocumentationFile></DocumentationFile>
    <NoWarn>CA1416,42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DocumentationFile></DocumentationFile>
    <DefineDebug>false</DefineDebug>
    <NoWarn>CA1416,42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
    <DebugType>none</DebugType>
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Autodesk.Connectivity.Explorer.Extensibility">
      <HintPath>C:\Program Files\Autodesk\Autodesk Vault 2027 SDK\bin\x64\Autodesk.Connectivity.Explorer.Extensibility.dll</HintPath>
    </Reference>
    <Reference Include="Autodesk.Connectivity.Explorer.ExtensibilityTools">
      <HintPath>C:\Program Files\Autodesk\Autodesk Vault 2027 SDK\bin\x64\Autodesk.Connectivity.Explorer.ExtensibilityTools.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.Connectivity.Extensibility.Framework">
      <HintPath>C:\Program Files\Autodesk\Autodesk Vault 2027 SDK\bin\x64\Autodesk.Connectivity.Extensibility.Framework.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.Connectivity.WebServices">
      <HintPath>C:\Program Files\Autodesk\Autodesk Vault 2027 SDK\bin\x64\Autodesk.Connectivity.WebServices.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.DataManagement.Client.Framework">
      <HintPath>C:\Program Files\Autodesk\Autodesk Vault 2027 SDK\bin\x64\Autodesk.DataManagement.Client.Framework.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.DataManagement.Client.Framework.Forms">
      <HintPath>C:\Program Files\Autodesk\Autodesk Vault 2027 SDK\bin\x64\Autodesk.DataManagement.Client.Framework.Forms.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.DataManagement.Client.Framework.Vault">
      <HintPath>C:\Program Files\Autodesk\Autodesk Vault 2027 SDK\bin\x64\Autodesk.DataManagement.Client.Framework.Vault.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.DataManagement.Client.Framework.Vault.Forms">
      <HintPath>C:\Program Files\Autodesk\Autodesk Vault 2027 SDK\bin\x64\Autodesk.DataManagement.Client.Framework.Vault.Forms.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>C:\Program Files\Autodesk\Inventor 2027\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="FileSelectionForm.Designer.vb">
      <DependentUpon>FileSelectionForm.vb</DependentUpon>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="SetupCAFE\SetupCAFE.isproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons8-Windows-8-Food-Cafe.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="fin.mp3" />
    <Content Include="SetupCAFE\SetupCAFE.iss" />
  </ItemGroup>
  <ItemGroup>
    <None Update="CreateAssemblyFromExcelAddin.Inventor.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="DeployAddin" AfterTargets="Build">
    <Exec Condition="'$(Configuration)'=='Debug'" Command="XCopy &quot;$(OutDir)*.*&quot; &quot;C:\ProgramData\Autodesk\Inventor Addins\$(ProjectName)\&quot; /Y /R /S" />
    <MakeDir Condition="'$(Configuration)'=='Debug'" Directories="C:\Logs" />
    <Exec Condition="'$(Configuration)'=='Release' And Exists('$(ProjectDir)Installer\installer.iss')" WorkingDirectory="$(ProjectDir)Installer" Command="&quot;C:\Program Files (x86)\Inno Setup 6\ISCC.exe&quot; &quot;installer.iss&quot;" />
  </Target>
</Project>